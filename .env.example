# Environment Configuration
# ENVIRONMENT=development keeps the demo console usable without credentials.
# Any other value (staging/production) enforces: a real SECRET_KEY, an ADMIN_API_KEY, fail-closed CPNI scopes.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Security (REQUIRED outside development; app refuses to start otherwise)
#   SECRET_KEY:     python -c "import secrets; print(secrets.token_urlsafe(48))"
#   ADMIN_API_KEY:  sent by operators as the X-API-Key header (OSS resets, HITL queue, self-healing)
SECRET_KEY=
ADMIN_API_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CPNI_ENCLAVE_ENABLED=true

# Optional: relocate the runtime datasets (defaults to <repo>/data)
# DATA_DIR=/srv/telco/data

# Hybrid Cloud Strategy (OpenStack on-prem + Google Cloud Platform)
OPENSTACK_ENABLED=true
OPENSTACK_AUTH_URL=http://openstack-keystone.internal:5000/v3
OPENSTACK_VLLM_ENDPOINT=http://openstack-vllm.internal:8000/v1
OPENSTACK_OPENSEARCH_ENDPOINT=http://openstack-opensearch.internal:9200
OPENSTACK_REDIS_ENDPOINT=redis://openstack-redis.internal:6379/0

GCP_ENABLED=true
GCP_PROJECT_ID=telco-agentic-prod
GCP_REGION=us-central1
GCP_VERTEX_AI_MODEL=gemini-1.5-flash
GCP_BIGQUERY_DATASET=telco_lakehouse
GCP_PUBSUB_TOPIC=telco-telemetry-events

# Thresholds & Limits
INTENT_CONFIDENCE_THRESHOLD=0.82
RAG_RELEVANCE_THRESHOLD=0.70
CHURN_RISK_THRESHOLD=0.75
FRUSTRATION_VELOCITY_THRESHOLD=-0.5
MAX_AGENT_STEPS=6
MAX_REFUND_AUTONOMOUS=50.0
MAX_REFUND_SUPERVISOR_REQUIRED=100.0
MAX_MESSAGE_CHARS=2000
